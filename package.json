{
  "name": "raad",
  "private": true,
  "version": "1.1.56",
  "type": "module",
  "scripts": {
    "start": "vite --host",
    "dev": "vite --host",
    "start-local": "vite",
    "test": "jest",
    "build": "tsc && vite build",
    "lint": "eslint . --ext js,jsx,ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview --host",
    "prerelease": "standard-version --prerelease alpha",
    "release": "standard-version",
    "release-as": "standard-version --no-verify --release-as 0.0.1",
    "generate-pwa-assets": "pwa-assets-generator --preset minimal public/logo.svg",
    "release-as-major": "standard-version --no-verify --release-as major",
    "release-as-minor": "standard-version --no-verify --release-as minor",
    "release-as-patch": "standard-version --no-verify --release-as patch",
    "prettier-check": "npx prettier src//**/*.{js,jsx,ts,tsx,css} --check",
    "prettier-write": "npx prettier --write src//**/*.{js,jsx,ts,tsx,css} --config ./.prettierrc",
    "clean": "cache clean --force",
    "docker-build": "wsl docker build -t raad_frontend .",
    "docker-run": "wsl docker run -e APP_API_URL=172.16.21.11:8082 -p 3100:3100 raad_frontend",
    "docker-containers": "wsl docker container ls",
    "docker-remove-container": "wsl docker rm -f containerId",
    "docker-images": "wsl docker images",
    "docker-remove-image": "wsl docker image rm imageId"
  },
